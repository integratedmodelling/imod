/* REVIEW DRAFT, 2026-10-23. NO RECORDED COMMUNITY ACCEPTANCE.
 * Full replacement overlay for the same-named baseline namespace, not an additional
 * namespace to load alongside it. Existing declarations above the review divider
 * are baseline context, not newly proposed approvals. See PROPOSALS.md for evidence,
 * priorities, alternatives, bearer/endpoint contracts and discriminating tests.
 * Owner discussion/incorporation is distinct from community acceptance.
 * Status uses ordinary comments pending the common cross-domain annotation convention.
 * Parser results are in VALIDATION.md; no linking/reasoner/runtime acceptance claimed.
 */
ontology biology
	version 1.0
	using imod, life, physical
	in domain imod:Biology;

/**
 * ## Biological synthesis and membrane transfer
 *
 * Photosynthesis uses light in biological synthesis of energy-rich compounds.
 * Its meaning is not restricted to plants, oxygen production or one biochemical
 * pathway. MembraneTransport moves material across a biological membrane; the
 * transported substance, direction and mode of transfer distinguish particular
 * observations.
 *
 * A living individual and a portion of biological material have distinct
 * identities. Describing either process does not determine whether a cell or
 * organ is observed as an individual, a material structure or another kind of
 * entity. Models describe the participants, rates and conditions. Process names
 * alone do not establish a growth outcome or a newly instantiated organism.
 */
process Photosynthesis
    "Biological synthesis of energy-rich compounds using light energy.";

process MembraneTransport
    "Transfer of material across a biological membrane.";

// ===== NEW REVIEW PROPOSALS BELOW; BASELINE CONTEXT ABOVE =====

// PROPOSED B1: structural focus, not a claim that the membrane is an organism.
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0113",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/biology.json"
)
abstract thing BiologicalMembrane
    "An identified biological membrane separating specified material compartments."
    is physical:MaterialBody;

// PROPOSED B2: physiological families; no guaranteed growth or product creation.
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0114",
