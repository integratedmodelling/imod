process CollectiveCoordination
    "Activity through which agents coordinate their actions."
    is physical:Activity;

// PROPOSED A2: neutral agent-source interaction intermediate; target may be nonliving.
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0094",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/agency.json"
)
abstract functional relationship AgentInteraction
    "Dynamic interaction involving an agent as source and a substantial as target."
    links imod:Agent to (imod:Agent or imod:Subject);

