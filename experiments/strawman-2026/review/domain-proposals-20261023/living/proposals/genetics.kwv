    review_record="../../review-metadata-r1/records/living/genetics.json"
)
structural directed relationship GeneticMaterialInheritedFrom
    "An offspring individual inherits identified genetic material from a progenitor individual."
    links life:Individual to life:Individual;
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0151",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/genetics.json"
)
quantity TranscriptCount
    "The number of identified RNA transcripts in a specified cellular material body."
    is imod:Numerosity of life:CellularBody;
