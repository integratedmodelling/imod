// PROPOSED E3: endpoints are observed entities, not bookkeeping membership.
// CROSS-REVIEW LF8: acceptance blocked. Agent/MaterialBody bounds alone do not
// establish biological-source/abiotic-target eligibility. Network ancestry of
// the recognizing arrangement also needs alignment; no Ecosystem category chosen.
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0135",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/ecology.json"
)
functional directed relationship BioticAbioticCoupling
    "An identified biological agent interacts with an identified abiotic material body."
    links imod:Agent to physical:MaterialBody;
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0136",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/ecology.json"
)
abstract configuration BioticAbioticArrangement
    "A configuration recognized from biotic-abiotic coupling at an explicit ecological scope."
    emerges from ecology:BioticAbioticCoupling;
@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0137",
    revision="review-metadata-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../../review-metadata-r1/records/living/ecology.json"
