{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integratedmodelling.org/schemas/llm/domain-context-proposal.schema.json",
  "title": "k.LAB domain-context asset proposal",
  "description": "Versioned, reviewable proposals for k.LAB semantic assets. Concept proposals are fully specified; ontology, namespace and model records share the same lifecycle and extension envelope.",
  "type": "object",
  "required": ["proposal_schema", "context_pack_version", "proposal"],
  "properties": {
    "proposal_schema": {
      "const": "classpath:/schemas/llm/domain-context-proposal.schema.json"
    },
    "context_pack_version": {
      "const": "1.3"
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "qualifiedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Z][A-Za-z0-9_]*$"
    },
    "feedbackContainer": {
      "type": "object",
      "required": ["state", "comments", "decisions", "proposed_action_ids", "applied_action_ids", "last_reviewed_iteration"],
      "properties": {
        "state": {
          "enum": ["open", "changes_requested", "accepted", "rejected", "deferred"]
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feedbackRecord"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionRecord"
          }
        },
        "proposed_action_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "applied_action_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "last_reviewed_iteration": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "feedbackRecord": {
      "type": "object",
      "required": ["comment_id", "author", "iteration", "proposal_revision_id", "target", "stance", "comment", "evidence_refs", "proposed_action_ids", "status"],
      "properties": {
        "comment_id": {
          "$ref": "#/$defs/identifier"
        },
        "author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "proposal_revision_id": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field": {
          "$ref": "#/$defs/nullableString"
        },
        "area": {
          "$ref": "#/$defs/nullableString"
        },
        "stance": {
          "enum": ["question", "support", "object", "request_change"]
        },
        "comment": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_asset_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "proposed_change": {
          "$ref": "#/$defs/nullableString"
        },
        "proposed_action_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "status": {
          "enum": ["open", "accepted", "rejected", "superseded", "resolved"]
        },
        "resolution": {
          "$ref": "#/$defs/nullableString"
        },
        "resolved_in_iteration": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "decisionRecord": {
      "type": "object",
      "required": ["decision_id", "iteration", "decision", "rationale"],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/identifier"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "action_ids": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "introduced_in_iteration", "last_modified_in_iteration", "deleted_in_iteration", "replacement_asset_ids"],
      "properties": {
        "state": {
          "enum": ["proposed", "active", "deprecated", "deleted", "rejected"]
        },
        "introduced_in_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "last_modified_in_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "deleted_in_iteration": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "replacement_asset_ids": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "nameHistory": {
      "type": "object",
      "required": ["qualified_name", "from_iteration", "to_iteration"],
      "properties": {
        "qualified_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "from_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "to_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "rename_action_id": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "assetBase": {
      "type": "object",
      "required": ["asset_id", "asset_type", "qualified_name", "record_version", "name_history", "label", "disposition", "definition", "evidence_refs", "feedback", "lifecycle"],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/identifier"
        },
        "asset_type": {
          "enum": ["concept", "ontology", "namespace", "model"]
        },
        "qualified_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1
        },
        "record_hash": {
          "$ref": "#/$defs/nullableString"
        },
        "name_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameHistory"
          }
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "disposition": {
          "enum": ["propose", "reuse", "align", "needs_review", "defer", "not_a_worldview_concept"]
        },
        "definition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "extraction_rationale": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "epistemic_status": {
          "enum": ["explicit", "inferred", "modeling_choice", "contested"]
        },
        "feedback": {
          "$ref": "#/$defs/feedbackContainer"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "open_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "alternatives": {
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["includes", "excludes", "examples", "counterexamples"],
      "properties": {
        "includes": {
          "$ref": "#/$defs/stringArray"
        },
        "excludes": {
          "$ref": "#/$defs/stringArray"
        },
        "examples": {
          "$ref": "#/$defs/stringArray"
        },
        "counterexamples": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "semanticCoordinates": {
      "type": "object",
      "required": ["kind", "flags", "perspective", "dependence", "arity", "countable", "bearer_types", "participant_types", "relationship_source", "relationship_target", "value_kind", "aggregation_behavior"],
      "properties": {
        "kind": {
          "enum": ["thing", "agent", "event", "process", "relationship", "bond", "configuration", "quality", "class", "quantity", "ordering", "extent", "amount", "area", "duration", "length", "mass", "money", "volume", "weight", "acceleration", "angle", "charge", "electric-potential", "energy", "entropy", "pressure", "priority", "resistance", "resistivity", "temperature", "velocity", "viscosity", "attribute", "identity", "role", "realm", "domain"]
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": ["abstract", "subjective", "individual", "deliberative", "interactive", "reactive", "functional", "structural", "deniable", "rescaling"]
          },
          "uniqueItems": true
        },
        "perspective": {
          "enum": ["structural", "functional", "cross_perspective", "not_applicable"]
        },
        "dependence": {
          "enum": ["independent", "dependent", "relational", "not_applicable"]
        },
        "arity": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": ">=1"
            },
            {
              "type": "null"
            }
          ]
        },
        "countable": {
          "type": ["boolean", "null"]
        },
        "bearer_types": {
          "$ref": "#/$defs/stringArray"
        },
        "participant_types": {
          "$ref": "#/$defs/stringArray"
        },
        "relationship_source": {
          "$ref": "#/$defs/nullableString"
        },
        "relationship_target": {
          "$ref": "#/$defs/nullableString"
        },
        "value_kind": {
          "enum": ["boolean", "concept", "number", "rank", "geometry", "duration", "other", null]
        },
        "aggregation_behavior": {
          "enum": ["extensive", "intensive", "not_applicable", "unresolved", null]
        }
      },
      "additionalProperties": false
    },
    "typeInheritance": {
      "type": "object",
      "required": ["declaration_keyword", "odo_im_chain", "explicit_odo_derivation_required", "rationale"],
      "properties": {
        "declaration_keyword": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "odo_im_chain": {
          "const": "implicit"
        },
        "explicit_odo_derivation_required": {
          "const": false
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "ambiguity": {
      "type": "object",
      "required": ["status", "source_senses", "selected_sense", "excluded_senses", "resolution_rationale"],
      "properties": {
        "status": {
          "enum": ["unambiguous", "qualified", "unresolved"]
        },
        "source_senses": {
          "$ref": "#/$defs/stringArray"
        },
        "selected_sense": {
          "$ref": "#/$defs/nullableString"
        },
        "excluded_senses": {
          "$ref": "#/$defs/stringArray"
        },
        "resolution_rationale": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "orthogonalityRelation": {
      "type": "object",
      "required": ["other_asset_id", "relation", "a_varies_with_b_fixed", "b_varies_with_a_fixed", "rationale", "required_action"],
      "properties": {
        "other_asset_id": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "enum": ["orthogonal", "taxonomic", "dependent", "derived", "compositional", "partially_overlapping", "redundant", "conflicting"]
        },
        "a_varies_with_b_fixed": {
          "type": ["boolean", "null"]
        },
        "b_varies_with_a_fixed": {
          "type": ["boolean", "null"]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_action": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "orthogonality": {
      "type": "object",
      "required": ["atomic_dimension", "composite_of", "independently_variable_from", "relations", "assessment"],
      "properties": {
        "atomic_dimension": {
          "type": "boolean"
        },
        "composite_of": {
          "$ref": "#/$defs/stringArray"
        },
        "independently_variable_from": {
          "$ref": "#/$defs/stringArray"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orthogonalityRelation"
          }
        },
        "assessment": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "namedComposition": {
      "type": "object",
      "required": ["applicable", "domain_term", "articulated_expression", "naming_rationale", "salience", "equals_vs_is_review_required", "proposed_outcome", "equivalence_assessment", "reviewer_decision"],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "domain_term": {
          "$ref": "#/$defs/nullableString"
        },
        "articulated_expression": {
          "$ref": "#/$defs/nullableString"
        },
        "naming_rationale": {
          "$ref": "#/$defs/nullableString"
        },
        "salience": {
          "type": "object",
          "required": ["level", "citation_evidence_refs", "occurrence_count", "independent_source_count", "canonical_definition_refs", "discourse_uses"],
          "properties": {
            "level": {
              "enum": ["peripheral", "established", "core"]
            },
            "citation_evidence_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "occurrence_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "independent_source_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "canonical_definition_refs": {
              "$ref": "#/$defs/stringArray"
            },
            "discourse_uses": {
              "type": "array",
              "items": {
                "enum": ["explanation", "annotation", "query", "model_definition", "community_governance"]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "equals_vs_is_review_required": {
          "type": "boolean"
        },
        "proposed_outcome": {
          "enum": ["keep_expression", "alias_with_equals", "specialize_with_is", "unresolved"]
        },
        "equivalence_assessment": {
          "type": "object",
          "required": ["same_intension", "same_extension", "same_perspective_and_category", "same_context_and_dependence", "same_value_space_and_predicates", "rationale"],
          "properties": {
            "same_intension": {
              "type": ["boolean", "null"]
            },
            "same_extension": {
              "type": ["boolean", "null"]
            },
            "same_perspective_and_category": {
              "type": ["boolean", "null"]
            },
            "same_context_and_dependence": {
              "type": ["boolean", "null"]
            },
            "same_value_space_and_predicates": {
              "type": ["boolean", "null"]
            },
            "rationale": {
              "$ref": "#/$defs/nullableString"
            }
          },
          "additionalProperties": false
        },
        "reviewer_decision": {}
      },
      "additionalProperties": false
    },
    "alignmentCandidate": {
      "type": "object",
      "required": ["concept", "relation", "score", "rationale"],
      "properties": {
        "concept": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relation": {
          "enum": ["is", "equals", "reuse", "authority"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "ancestryReference": {
      "type": "object",
      "required": ["ref_kind", "asset_id", "qualified_name"],
      "properties": {
        "ref_kind": {
          "enum": ["internal", "external"]
        },
        "asset_id": {
          "$ref": "#/$defs/nullableString"
        },
        "qualified_name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "alignment": {
      "type": "object",
      "required": ["action", "selected_parent", "direct_parent_tier", "tier_1_ancestor", "ancestry_to_tier_1", "ancestry_status", "contextualized_within", "candidates", "rejected_candidates"],
      "properties": {
        "action": {
          "enum": ["implicit_type_only", "reuse_exact", "specialize", "authority_reference", "new_root_candidate", "unresolved"]
        },
        "selected_parent": {
          "$ref": "#/$defs/nullableString"
        },
        "direct_parent_tier": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "tier_1_ancestor": {
          "$ref": "#/$defs/nullableString"
        },
        "ancestry_to_tier_1": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ancestryReference"
          }
        },
        "ancestry_status": {
          "enum": ["verified", "missing_parent", "missing_tier_1_ancestor", "unresolved", "not_applicable"]
        },
        "contextualized_within": {
          "$ref": "#/$defs/nullableString"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alignmentCandidate"
          }
        },
        "rejected_candidates": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "conceptAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["asset_type", "abstract", "section", "tier", "tier_rationale", "conceptual_dimension", "boundaries", "semantic_coordinates", "category_rationale", "type_inheritance", "generalized_scope_aliases_used", "ambiguity", "orthogonality", "named_composition", "alignment", "predicates", "derivation", "clauses", "dependencies", "candidate_expression", "candidate_kwv", "syntax_status", "confidence"],
          "properties": {
            "asset_type": {
              "const": "concept"
            },
            "abstract": {
              "type": "boolean"
            },
            "section": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "tier": {
              "type": "integer",
              "minimum": 1
            },
            "tier_rationale": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "conceptual_dimension": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "boundaries": {
              "$ref": "#/$defs/boundaries"
            },
            "semantic_coordinates": {
              "$ref": "#/$defs/semanticCoordinates"
            },
            "category_rationale": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type_inheritance": {
              "$ref": "#/$defs/typeInheritance"
            },
            "generalized_scope_aliases_used": {
              "$ref": "#/$defs/stringArray"
            },
            "ambiguity": {
              "$ref": "#/$defs/ambiguity"
            },
            "orthogonality": {
              "$ref": "#/$defs/orthogonality"
            },
            "named_composition": {
              "$ref": "#/$defs/namedComposition"
            },
            "alignment": {
              "$ref": "#/$defs/alignment"
            },
            "predicates": {
              "type": "object",
              "required": ["identities", "realms", "attributes", "roles"],
              "properties": {
                "identities": {
                  "$ref": "#/$defs/stringArray"
                },
                "realms": {
                  "$ref": "#/$defs/stringArray"
                },
                "attributes": {
                  "$ref": "#/$defs/stringArray"
                },
                "roles": {
                  "$ref": "#/$defs/stringArray"
                }
              },
              "additionalProperties": false
            },
            "derivation": {
              "type": "object",
              "required": ["operator", "operand", "secondary_operand", "rationale"],
              "properties": {
                "operator": {
                  "$ref": "#/$defs/nullableString"
                },
                "operand": {
                  "$ref": "#/$defs/nullableString"
                },
                "secondary_operand": {
                  "$ref": "#/$defs/nullableString"
                },
                "rationale": {
                  "$ref": "#/$defs/nullableString"
                }
              },
              "additionalProperties": false
            },
            "clauses": {
              "type": "object",
              "required": ["inherits", "applies_to", "links", "creates", "affects", "emerges_from", "implies", "describes", "requires", "children"],
              "properties": {
                "inherits": {
                  "$ref": "#/$defs/stringArray"
                },
                "applies_to": {
                  "$ref": "#/$defs/stringArray"
                },
                "links": {},
                "creates": {
                  "$ref": "#/$defs/stringArray"
                },
                "affects": {
                  "$ref": "#/$defs/stringArray"
                },
                "emerges_from": {
                  "$ref": "#/$defs/stringArray"
                },
                "implies": {
                  "$ref": "#/$defs/stringArray"
                },
                "describes": {},
                "requires": {
                  "type": "array"
                },
                "children": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "dependencies": {
              "$ref": "#/$defs/stringArray"
            },
            "candidate_expression": {
              "$ref": "#/$defs/nullableString"
            },
            "candidate_kwv": {
              "$ref": "#/$defs/nullableString"
            },
            "syntax_status": {
              "enum": ["not_attempted", "illustrative", "parsed", "adapted", "reasoner_validated"]
            },
            "confidence": {
              "type": "object",
              "required": ["extraction", "category", "alignment", "unambiguity", "orthogonality"],
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "ontologyAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["asset_type", "tier", "domain_expression", "imports", "member_asset_ids"],
          "properties": {
            "asset_type": {
              "const": "ontology"
            },
            "tier": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "domain_expression": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "imports": {
              "$ref": "#/$defs/stringArray"
            },
            "member_asset_ids": {
              "$ref": "#/$defs/stringArray"
            },
            "proposal_data": {
              "type": "object"
            }
          }
        }
      ]
    },
    "namespaceAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["asset_type", "namespace_kind", "imports", "member_asset_ids"],
          "properties": {
            "asset_type": {
              "const": "namespace"
            },
            "namespace_kind": {
              "enum": ["namespace", "scenario", "worldview"]
            },
            "imports": {
              "$ref": "#/$defs/stringArray"
            },
            "member_asset_ids": {
              "$ref": "#/$defs/stringArray"
            },
            "proposal_data": {
              "type": "object"
            }
          }
        }
      ]
    },
    "modelAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "required": ["asset_type", "namespace_asset_id", "observables", "dependencies", "strategy_summary"],
          "properties": {
            "asset_type": {
              "const": "model"
            },
