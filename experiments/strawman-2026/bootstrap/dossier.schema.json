{
  "type": "object",
  "required": [
    "dossier_version",
    "domain",
    "status",
    "scope",
    "imports",
    "sources",
    "concepts",
    "questions",
    "quality_summaries",
    "ambiguities",
    "coverage",
    "validation"
  ],
  "properties": {
    "dossier_version": {
      "const": "0.1"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "imports": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "locator",
          "scope",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "definition",
          "parent",
          "parent_status",
          "qualities",
          "parameters",
          "bindings",
          "source_ids",
          "positive",
          "negative",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "subject",
              "process",
              "relationship",
              "event",
              "quality",
              "predicate"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_status": {
            "enum": [
              "verified_reference",
              "proposed_parent",
              "blocked"
            ]
          },
          "qualities": {
            "type": "array"
          },
          "parameters": {
            "type": "array"
          },
          "bindings": {
            "type": "object"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "positive": {
            "type": "string",
            "minLength": 1
          },
          "negative": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "concept_ids",
          "expression",
          "expected_type",
          "dependencies",
          "positive",
          "negative",
          "source_ids",
          "semantic_status",
          "grammar_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "concept_ids": {
            "type": "array"
          },
          "expression": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_type": {
            "type": "string",
            "minLength": 1,
            "description": "Compatibility alias for expression_result_category; unresolved for a full-formulation gap. Not narrative intent or a type-check result."
          },
          "dependencies": {
            "type": "array"
          },
          "positive": {
            "type": "string",
            "minLength": 1
          },
          "negative": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "semantic_status": {
            "type": "string",
            "minLength": 1
          },
          "grammar_status": {
            "type": "string",
            "minLength": 1
          },
          "narrative_intent": {
            "type": "string"
          },
          "expression_result_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "expression_result_basis": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "description": "Explicitly insufficient or partial component expressions; not counted as complete question formulations."
          }
        },
        "additionalProperties": true
      },
      "description": "At least fifteen research slots; additions may preserve inherited IDs and broaden evidence. Count is diagnostic, not answerability or scientific coverage."
    },
    "quality_summaries": {
      "type": "array"
    },
    "ambiguities": {
      "type": "array"
    },
    "coverage": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imod:experimental:bootstrap-dossier:0.1",
  "title": "Local research dossier, not production context-pack proposal schema",
  "description": "Additional research fields permitted; production schema unchanged. Semantic tests are separate."
}
