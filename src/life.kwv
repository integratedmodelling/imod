/**
 * # Living phenomena
 *
 * This physical namespace articulates living phenomena without an intrinsic
 * Earth restriction. Biology, ecology and genetics identify Life as physical
 * subject matter through about; this does not settle organism agency or taxonomy.
 */
ontology life
	version 1.0
	using imod
	in domain imod:Life;

abstract identity TaxonomicIdentity
	requires authority TAXA {
        urn: "klab.authority.taxa",
        datasetKey: 312578
		codelists: {
        	species: "taxonomy.species",
        	genera:  "taxonomy.genera"
    	}
	};

abstract agent Individual;

structural relationship SocialConnection;

abstract agent SocialGroup 
	emerges from life:SocialConnection;