/**
 * # Land cover and use
 *
 * LandCover identifies cover distinctions within a descriptive perspective
 * concerning Earth, Society and Life. Physical cover and its social uses provide
 * related perspectives on the same land without equating their meanings.
 */
ontology land
	"Descriptive identities for land cover within its physical, living and social context."
	version 1.0
	using imod, society, earth, life
	in domain imod:Land;

	
identity LandCover 
	"An identity used to classify the physical cover of a land surface."
	requires authority LAND {
        urn: "klab.authority.land",
        mode: "ENTRY_ONLY",
        domain: "LULC",
        catalogs: ("corine_entry_hierarchy_example"),
        codelists: { corine_entry_hierarchy_example: "land.corine" }
    };

/**
 * ## Experimental first-level articulation
 *
 * These observations extend the shared vocabulary for multidisciplinary review.
 * Their declaration-local review records preserve rationale, alternatives and
 * exact validation evidence. Experimental inclusion is distinct from recorded
 * community acceptance; models still establish occurrence, support and outcomes.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0079",
    revision="strawman-integration-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/domain-integration-20261023/records/earth/land.json"
)
event CoverChangeEpisode
    "A bounded occurrence in which physical cover changes on an identified land surface unit.";
