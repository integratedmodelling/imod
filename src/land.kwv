/**
 * # Land cover and use
 *
 * LandCover identifies cover distinctions within a descriptive perspective
 * concerning Earth, Society and Life. Physical cover and its social uses provide
 * related perspectives on the same land without equating their meanings.
 */
ontology land
	"Descriptive identities for land cover within its physical, living and social context."
	version 1.0
	using imod, society, earth, life
	in domain imod:Land;

	
identity LandCover 
	"An identity used to classify the physical cover of a land surface."
	requires authority LAND {
        urn: "klab.authority.land",
        mode: "ENTRY_ONLY",
        domain: "LULC",
        catalogs: ("corine_entry_hierarchy_example"),
        codelists: { corine_entry_hierarchy_example: "land.corine" }
    };
