ontology geography
    version 1.0
	using imod, physical, earth
	in domain imod:Physical;

angle Heading
	"A direction relative to the geographical North of the earth.";

@colormap("terrain", center=0, min=-10935, max=8849)
length Elevation 
	"Geographical elevation above sea level, as described by a digital
	 elevation model."
	is physical:Height of earth:Location
   affected by earth:Erosion;

angle Aspect 
   "The compass direction that a slope faces. For example, a slope on the
    eastern edge of the Rockies toward the Great Plains is described as having 
   an easterly aspect."
   // TODO expand orientations
   // describes physical:MagneticPlanetaryOrientation of earth:Location
;
		 
length BathymetricDepth
	"Depth of earth's crust below sea level, as described by a digital bathymetry model."
   // TODO should be of terrain - maybe 'within' could do it as a shortcut
	describes physical:Height of earth:Location
;

angle Slope
   "Inclination of the above-water terrain in a geographical region."
   // TODO should be of terrain - maybe 'within' could do it as a shortcut
   describes imod:Angle of earth:Location;

/*
 * FIXME there are excellent arguments to expect that any configuration is
 * defined in a knowledge domain
 */
configuration Terrain 
   "The perceived three-dimensional configuration of land surfaces"
   is physical:SpatialArrangement of (earth:Crust earth:Terrestrial earth:Region)
   emerges from (geography:Elevation or geography:Slope or geography:Aspect);

/**
 * ## Longitudinal stream gradients
 *
 * StreambedGradient characterizes the bed's longitudinal profile; practitioners
 * also use the term StreamGradient. WaterSurfaceGradient characterizes the
 * profile of the water surface at the time observed. Bed geometry persists
 * through dry periods, while a water-surface profile is recognized where a
 * continuous water surface exists over the observed reach.
 *
 * Each gradient is the elevation fall of its own reference surface divided by
 * the horizontal length of the channel course over a specified reach, following
 * its bends. The elevation fall is measured from the upstream endpoint to the
 * downstream endpoint. Both distances use compatible length units, giving a
 * dimensionless ratio such as metres per metre; a percentage is one hundred
 * times that ratio. The reference surface and reach distinguish the two
 * measurements even when their values happen to coincide.
 *
 * The length-ratio convention follows [USGS StreamStats basin characteristics](https://streamstats.usgs.gov/information-portal/characteristics.html).
 * Channel-course distance and bed profiles are discussed in
 * [Hack's stream-profile analysis](https://pubs.usgs.gov/journal/1973/vol1issue4/report.pdf).
 * Water-surface gradient is distinguished in the
 * [USGS stream-habitat data standard](https://pubs.usgs.gov/publication/tm16B2/full).
 */
quantity StreambedGradient
    "Streambed elevation fall per unit horizontal channel-course length over a specified reach; commonly called StreamGradient."
    is imod:Ratio of earth:Stream
    describes earth:StreambedProfile;

quantity WaterSurfaceGradient
    "Water-surface elevation fall per unit horizontal channel-course length over a specified stream reach at the time observed."
    is imod:Ratio of earth:Stream
    describes earth:WaterSurfaceProfile;

angle BathymetricSlope
	"Inclination of the below-water terrain in a geographical region."
	is imod:Angle of earth:Location;
	
length SlopeLength 
	""
	is imod:Length of earth:Location
;

/**
 * Political/Regional geography. Knowledge below was in policy which is obviously
 * inappropriate. Not sure it should have its own namespace.
 * KB: The question is whether we want to combine human and physical geography into one namespace.
  If so, keep it here, if not make a human geography namespace (my vote would be to keep them combined, 
  as we don't split other ontologies into subdisciplines).
 */	
 
 /** 
  * TODO traits of identities should propagate - so a China Individual hasTrait Asian and Eastern (CHECK!)
  * */
 
abstract identity GeographicalIdentity
 	"Any abstract identity we can use to divide the world up into disjoint entities."
 	has children
 		(abstract GeopoliticalIdentity
 			""
 		),
 		(abstract RegionalIdentity
 			""
 		);

//Potentially useful e.g., to distinguish that the cold season is in the winter in the Northern Hemisphere and summer in the Southern Hemisphere.
//Northern is of course not actually disjoint with eastern/western - so may need to be split differently.
abstract identity Hemisphere is geography:RegionalIdentity
	has children
	(abstract LatitudinalHemisphere
		has disjoint children
			NorthernHemisphere,
			SouthernHemisphere		
	),
	(abstract LongitudinalHemisphere
		has disjoint children
			EasternHemisphere,
			WesternHemisphere
	);

abstract identity Continental is geography:RegionalIdentity
	has disjoint children
		(African inherits geography:WesternHemisphere),
		(Antarctic inherits geography:SouthernHemisphere),
		(Asian inherits geography:EasternHemisphere),
		(Australian inherits geography:SouthernHemisphere, geography:EasternHemisphere),
		(European inherits geography:NorthernHemisphere, geography:WesternHemisphere),
		(NorthAmerican inherits geography:NorthernHemisphere, geography:WesternHemisphere),
		(Oceanian inherits geography:SouthernHemisphere, geography:EasternHemisphere),
		(SouthAmerican inherits geography:WesternHemisphere); 
 
 
// TODO harmonize with the above, which must be fixed.
abstract identity ContinentalRegion
	applies to earth:Location
	has disjoint children
		AfricanRegion, 
		AsianRegion,         
		InsularAsianRegion,             
		AustralianRegion,    
		EuropeanRegion,      
		NorthAmericanRegion, 
		SouthAmericanRegion,
		AntarcticRegion,
		ArcticRegion,
		PacificRegion,
		AtlanticRegion,
		IndianRegion; 
 

@experimental
quality TopographicHeterogeneity
   describes imod:Heterogeneity of geography:Terrain
//   within earth:Location
   ;