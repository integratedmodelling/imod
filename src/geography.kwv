/**
 * # Geography: Earth locations and spatial descriptions
 *
 * Geography provides descriptive knowledge of Earth locations, terrain and spatial
 * organization. Its domain is Knowledge about Earth. This establishes subject
 * matter; individual qualities retain their own bearers and description targets.
 * The first section distinguishes directional and terrain measurements. Terrain
 * then names a spatial pattern, followed by regional identities
 * used to qualify locations and observations.
 *
 * ## Measurements and recognized terrain
 *
 * Aspect concerns direction; Elevation and BathymetricDepth concern
 * vertical position relative to a reference; slopes express inclination. A digital
 * model is evidence for a measurement, not the definition of its physical bearer.
 * A quality's bearer identifies what bears it; a description target identifies
 * what is described. Those relations remain distinct when the namespace is
 * understood as Knowledge about Earth.
 * Elevation describes a terrestrial spatial arrangement without asserting that
 * its Region bearer is within the Crust realm. A crustal source of measurements
 * does not establish that containment. Terrain retains its own narrower application target.
 */
ontology geography
    version 1.0
	using imod, physical, earth
	in domain imod:Geography;

configuration TerrestrialSurfaceArrangement
    "Spatial arrangement as applied to a terrestrial Region; no Crust restriction or emergence ingredients are added."
    is physical:SpatialArrangement
    applies to (earth:Terrestrial earth:Region);

@colormap("terrain", center=0, min=-10935, max=8849)
length Elevation 
    "Elevation of an Earth surface above sea level."
    is physical:Height of earth:Location
    describes geography:TerrestrialSurfaceArrangement
   affected by earth:Erosion;

angle Aspect
    "The compass direction faced by a terrain slope."
    describes geography:Terrain;
		 
length BathymetricDepth
	"Depth of earth's crust below sea level, as described by a digital bathymetry model."
	describes physical:Height of earth:Location
;

angle Slope
   "Inclination of the above-water terrain in a geographical region."
   describes imod:Angle of earth:Location;

/**
 * ## Terrain as a configuration
 *
 * Terrain is a three-dimensional pattern of terrestrial surface relief,
 * characterized through elevation, slope and aspect. Its Knowledge ownership expresses this descriptive viewpoint;
 * it does not establish that every Configuration belongs to a Knowledge domain.
 * The emergence expression relates this configuration to the elevation, slope
 * and aspect through which terrain is recognized.
 */
configuration Terrain 
   "The three-dimensional pattern of terrestrial surface relief."
   is physical:SpatialArrangement
   applies to (earth:Crust earth:Terrestrial earth:Region)
   emerges from (geography:Elevation or geography:Slope or geography:Aspect);

/**
 * ## Longitudinal stream gradients
 *
 * StreambedGradient characterizes the bed's longitudinal profile; practitioners
 * also use the term StreamGradient. WaterSurfaceGradient characterizes the
 * profile of the water surface at the time observed. Bed geometry persists
 * through dry periods, while a water-surface profile is recognized where a
 * continuous water surface exists over the observed reach.
 *
 * Each gradient is the elevation fall of its own reference surface divided by
 * the horizontal length of the channel course over a specified reach, following
 * its bends. The elevation fall is measured from the upstream endpoint to the
 * downstream endpoint. Both distances use compatible length units, giving a
 * dimensionless ratio such as metres per metre; a percentage is one hundred
 * times that ratio. The reference surface and reach distinguish the two
 * measurements even when their values happen to coincide.
 *
 * The length-ratio convention follows [USGS StreamStats basin characteristics](https://streamstats.usgs.gov/information-portal/characteristics.html).
 * Channel-course distance and bed profiles are discussed in
 * [Hack's stream-profile analysis](https://pubs.usgs.gov/journal/1973/vol1issue4/report.pdf).
 * Water-surface gradient is distinguished in the
 * [USGS stream-habitat data standard](https://pubs.usgs.gov/publication/tm16B2/full).
 */
quantity StreambedGradient
    "Streambed elevation fall per unit horizontal channel-course length over a specified reach; commonly called StreamGradient."
    is imod:Ratio of earth:Stream
    describes earth:StreambedProfile;

quantity WaterSurfaceGradient
    "Water-surface elevation fall per unit horizontal channel-course length over a specified stream reach at the time observed."
    is imod:Ratio of earth:Stream
    describes earth:WaterSurfaceProfile;

/**
 * ## Inclination of submerged ground
 *
 * BathymetricSlope is the angular inclination of a submerged ground surface
 * relative to the local horizontal plane. It characterizes the underwater
 * spatial pattern recognized as Bathymetry at an Earth location. The reference
 * surface is the ground beneath the water, distinct from the water surface.
 */
configuration LocatedBathymetry
    "Bathymetry as applied to an Earth Location; the application target is not an emergence ingredient."
    is earth:Bathymetry
    applies to earth:Location;

angle BathymetricSlope
    "The angular inclination of a submerged ground surface relative to the local horizontal plane at an Earth location."
    is imod:Angle of earth:Location
    describes geography:LocatedBathymetry;
	
/**
 * ## Lengths used in erosion assessment
 *
 * ErosionSlopeLength measures the horizontal projection along a runoff route
 * from its origin to the first onset of deposition caused by flattening or
 * entry into a defined concentrated-flow channel, whichever occurs first.
 * This is the classic USLE/RUSLE slope length. OverlandFlowPathLength measures
 * the full route to concentrated channel flow, continuing through depositional
 * portions under the RUSLE2 convention.
 *
 * Each measurement follows the route's horizontal projection through its bends,
 * rather than the straight chord between its endpoints or the three-dimensional
 * distance over the ground surface. Both are lengths, expressed in units such
 * as metres. The associated profile identifies the extent being measured on
 * the delineated route. The erosion slope-length factor L and combined LS
 * factor are dimensionless quantities distinct from these physical lengths.
 *
 * The traditional slope length is defined in [USDA Agriculture Handbook 703, chapter 4, page 104](https://directives.nrcs.usda.gov/sites/default/files2/1712932574/28651.pdf).
 * The full-path convention is explained in the [USDA-ARS RUSLE2 definitions](https://www.ars.usda.gov/southeast-area/oxford-ms/national-sedimentation-laboratory/watershed-physical-processes-research/research/rusle2/revised-universal-soil-loss-equation-2-rusle2-definitions/).
 * Horizontal measurement and profile segmentation are described in the
 * [RUSLE2 User's Reference Guide, section 8.1](https://www.ars.usda.gov/ARSUserFiles/60600505/RUSLE/RUSLE2_User_Ref_Guide.pdf).
 */
length ErosionSlopeLength
    "Horizontal projected distance along a runoff route to first deposition caused by flattening or channel entry: the classic erosion slope length."
    is imod:Length of earth:OverlandFlowRoute
    describes earth:ErosionalSlopeProfile;

length OverlandFlowPathLength
    "Horizontal projected distance along the full runoff route to concentrated channel flow, including depositional portions."
    is imod:Length of earth:OverlandFlowRoute
    describes earth:OverlandFlowProfile;

/**
 * ## Regional and geopolitical identities
 *
 * Physical and human geography share this namespace in the strawman. Their common
 * purpose here is to qualify places and observations through geographical,
 * regional and geopolitical distinctions.
 *
 * The two hemispheric axes are separate: north/south and east/west can overlap
 * across axes. Continental predicates qualify observations by continental
 * affiliation; ContinentalRegion identifies regional locations.
 */

abstract identity GeographicalIdentity
 	"An identity qualifying places or observations by geographical affiliation."
 	has children
 		(abstract GeopoliticalIdentity
 			""
 		),
 		(abstract RegionalIdentity
 			""
 		);

/**
 * ## Identities from M49
 *
 * M49GeographicalIdentity keeps identities from the configured
 * [UNSD M49 classification](https://unstats.un.org/unsd/methodology/m49/overview/)
 * on their own branch. The scheme contains statistical regions and countries
 * or areas. Its classifications and canonical source identities remain distinct
 * from other geographical classifications and from the places they describe.
 *
 * M49SelfGoverningIdentity records a narrower source attestation: the configured
 * provider matches an M49 code to a geopolitical record explicitly classified
 * as self-governing. This does not classify every M49 country-or-area entry in
 * that subset, define a general Country category, or establish sovereignty or
 * the current status of a particular government.
 *
 * Other geographical authorities can use separate branches of
 * GeographicalIdentity. Shared names, numerical codes or geographical coverage
 * do not alone establish equivalent identities across their classifications.
 */
abstract identity M49GeographicalIdentity
    "A geographical identity drawn from the configured UNSD M49 classification."
    is geography:GeographicalIdentity
    requires authority UN.M49 {
        urn: "klab.authority.un",
        catalog: "M49",
        language: "en",
        semanticBoundaries: {
            "M49_COUNTRY": "geography:M49SelfGoverningIdentity"
        }
    };

abstract identity M49SelfGoverningIdentity
    "An M49 geographical identity matched by the configured source to an explicitly self-governing geopolitical record."
    is geography:M49GeographicalIdentity;

/**
 * Hemispheric identities support distinctions such as opposite seasonal timing
 * north and south of the equator. Disjointness is stated within each axis only.
 */
abstract identity Hemisphere is geography:RegionalIdentity
	has children
	(abstract LatitudinalHemisphere
		has disjoint children
			NorthernHemisphere,
			SouthernHemisphere		
	),
	(abstract LongitudinalHemisphere
		has disjoint children
			EasternHemisphere,
			WesternHemisphere
	);

abstract identity Continental is geography:RegionalIdentity
	has disjoint children
		(African inherits geography:WesternHemisphere),
		(Antarctic inherits geography:SouthernHemisphere),
		(Asian inherits geography:EasternHemisphere),
		(Australian inherits geography:SouthernHemisphere, geography:EasternHemisphere),
		(European inherits geography:NorthernHemisphere, geography:WesternHemisphere),
		(NorthAmerican inherits geography:NorthernHemisphere, geography:WesternHemisphere),
		(Oceanian inherits geography:SouthernHemisphere, geography:EasternHemisphere),
		(SouthAmerican inherits geography:WesternHemisphere); 
 
 
/**
 * ContinentalRegion groups identities applicable to Earth locations, including
 * continental, polar and oceanic regions.
 */
abstract identity ContinentalRegion
	applies to earth:Location
	has disjoint children
		AfricanRegion, 
		AsianRegion,         
		InsularAsianRegion,             
		AustralianRegion,    
		EuropeanRegion,      
		NorthAmericanRegion, 
		SouthAmericanRegion,
		AntarcticRegion,
		ArcticRegion,
		PacificRegion,
		AtlanticRegion,
		IndianRegion; 
 

/**
 * ## Variation within terrain
 *
 * TopographicHeterogeneity describes heterogeneity of a recognized Terrain.
 * It distinguishes variation within the configuration from the elevation or
 * inclination measured at an individual location.
 */
@experimental
quality TopographicHeterogeneity
   "Heterogeneity of a recognized terrain configuration."
   describes imod:Heterogeneity of geography:Terrain
   ;
