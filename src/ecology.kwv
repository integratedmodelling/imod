ontology ecology
	version 1.0
	using imod, life, biology
	in domain imod:Ecology;

abstract agent Population;

abstract agent Community
	emerges from ecology:Population;

/**
 * ## Consumption of plant material
 *
 * Herbivory describes an organism consuming plant material. The consumer, the
 * source organism and an ingested material portion are distinct participants;
 * observing consumption does not make them a single entity or assign agency to
 * a grouping. Herbivory includes feeding on portions of a living plant without
 * requiring the death of that plant.
 *
 * The process is distinct from a persistent feeding relationship, a bounded
 * feeding episode and a measured consumption rate. Observations establish what
 * was consumed and by whom; models describe effects on growth, survival and
 * ecological dynamics under the particular conditions.
 */
process Herbivory
    "Consumption of plant material by an organism.";

/**
 * ## Experimental first-level articulation
 *
 * These observations extend the shared vocabulary for multidisciplinary review.
 * Their declaration-local review records preserve rationale, alternatives and
 * exact validation evidence. Experimental inclusion is distinct from recorded
 * community acceptance; models still establish occurrence, support and outcomes.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0129",
    revision="strawman-integration-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/domain-integration-20261023/records/living/ecology.json"
)
process Predation
