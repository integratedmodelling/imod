/**
 * # Social participants
 *
 * Human individuals and institutions provide participants for descriptions of
 * social organization. HumanIndividual connects the Human taxonomic identity
 * with the individual vocabulary of Life; Institution names a collective agent.
 */
ontology society
	version 1.0
	using imod, life, agency
	in domain imod:Society;

identity Human
	equals TAXA:[6MB3T]
;

agent HumanIndividual
	is society:Human life:Individual;

agent Institution;