ontology engineering
	"Physical production and modification of engineered artifacts."
	version 1.0
	using imod, infrastructure, physical
	in domain imod:Engineering;

/**
 * ## Producing an assembled artifact
 *
 * ProductAssembly joins components to produce an artifact recognized as a new
 * entity. The product is distinct from the activity and from descriptions of its
 * design or acceptance. An intended function does not establish actual delivery.
 *
 * Joining or rejoining parts of a continuing artifact does not alone establish
 * production of a new one. Assembly that produces a new artifact is distinguished
 * here from modification of a continuing artifact. Observations and models
 * identify the participants and the criteria for the product's continuity.
 */
process ProductAssembly
    "Intentional joining of components to produce a new artifact entity."
    is infrastructure:ArtifactProduction;

/**
 * ## Experimental first-level articulation
 *
 * These observations extend the shared vocabulary for multidisciplinary review.
 * Their declaration-local review records preserve rationale, alternatives and
 * exact validation evidence. Experimental inclusion is distinct from recorded
 * community acceptance; models still establish occurrence, support and outcomes.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0014",
    revision="strawman-integration-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/domain-integration-20261023/records/foundations/review.engineering.json"
)
thing Pump
    "An individuated engineered device intended to impart energy to move fluid."
    is infrastructure:Artifact;

