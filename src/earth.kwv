	has children
			Winter,
			Spring,
			Summer,
			Fall;

abstract attribute WeatherDominance
	has children
		Cloudy,
		Wet,
		Snowy,
		Dry;

/**
 * ## Spatial configurations and Earth cover
 *
 * Bathymetry recognizes underwater spatial form, while LandCover concerns
 * terrestrial cover. Runoff-route profiles distinguish the spatial extents
 * used in erosion assessments.
 */
	
/**
 * ## Runoff routes and erosion profiles
 *
 * An OverlandFlowRoute is a delineated linear feature of the land surface,
 * following the course of overland runoff over the extent specified for an
 * erosion assessment. It can be recognized without water currently flowing
 * along it. Its delineation identifies both the course and the represented
 * extent, distinguishing it from other routes crossing the same location.
 *
 * ErosionalSlopeProfile recognizes the land-surface arrangement from the origin
 * of overland runoff to the first onset of deposition caused by flattening or
 * entry into a defined concentrated-flow channel, whichever comes first.
 * OverlandFlowProfile recognizes the arrangement from runoff origin through
 * any depositional portions to concentrated channel flow. Each profile specifies
 * the extent required by its endpoint convention. A delineation ending at
 * deposition onset is sufficient for the classic erosional-slope assessment.
 * A full-path assessment includes the continuation to channel entry.
 *
 * These distinctions follow the [USDA-ARS RUSLE2 definitions](https://www.ars.usda.gov/southeast-area/oxford-ms/national-sedimentation-laboratory/watershed-physical-processes-research/research/rusle2/revised-universal-soil-loss-equation-2-rusle2-definitions/).
 * Route selection and the criteria for recognizing deposition and channel
 * entry belong to the particular erosion assessment.
 */
thing OverlandFlowRoute
    "A delineated linear course of overland runoff on land, over the extent specified for an erosion assessment."
    is imod:Lineal earth:Terrestrial earth:Location;

configuration ErosionalSlopeProfile
    "The land-surface arrangement from overland-runoff origin to first deposition caused by flattening or entry into a defined concentrated-flow channel."
    is physical:SpatialArrangement
    applies to earth:OverlandFlowRoute;

configuration OverlandFlowProfile
    "The land-surface arrangement from overland-runoff origin to concentrated channel flow, including intervening depositional portions."
    is physical:SpatialArrangement
    applies to earth:OverlandFlowRoute;

configuration Bathymetry
	"The vertical and horizontal dimensions of underwater Earth surfaces"
	;	

configuration LandCover
	"The spatial arrangement of physical cover over the terrestrial Earth surface."
	// is earth:Terrestrial earth:EarthCover
	applies to earth:Location;

