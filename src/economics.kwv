ontology economics
   version 1.0
   using imod, data, valuation, physical, society, sociology
   in domain imod:Economics;



role EconomicAsset 
	is valuation:Asset;

/**
 * ## Market value
 *
 * MarketValue names the abstract monetary valuation of an economic asset.
 * Its applicability includes assets borne by subjects and agents, connecting
 * this economic perspective to the broader asset vocabulary of valuation.
 */
abstract money MarketValue
    "Market value attributed to an economic asset."
    applies to economics:EconomicAsset imod:Subject or economics:EconomicAsset imod:Agent;

/**
 * ## Experimental first-level articulation
 *
 * These observations extend the shared vocabulary for multidisciplinary review.
 * Their declaration-local review records preserve rationale, alternatives and
 * exact validation evidence. Experimental inclusion is distinct from recorded
 * community acceptance; models still establish occurrence, support and outcomes.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0159",
    revision="strawman-integration-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_priority="foundational",
    review_record="../docs/reviews/domain-integration-20261023/records/societal/economics.json"
)
role EconomicReportingUnit
    "The role of an identified substantial supplying the unit boundary for economic accounts."
    applies to (imod:Subject or imod:Agent);

