ontology hydrology
	version 1.0
	using imod, earth
	in domain imod:Hydrology;

/**
 * ## Liquid-water movement
 *
 * Channel flow follows a channel; overland flow moves across the ground surface
 * outside channel transport. A channel and the water moving through it have
 * different continuity: a channel can persist when no water is flowing.
 *
 * Infiltration crosses the ground surface into the underlying ground. It does
 * not by itself establish arrival at groundwater, replenishment of a particular
 * store, or any fixed partition of precipitation. Flow, stored volume and
 * discharge at a section describe different aspects of the water. Observations
 * identify the spatial support and interval; models describe the water balance.
 */
process ChannelFlow
    "Transport of liquid water along a channel.";

process OverlandFlow
    "Movement of liquid water across the ground surface outside channel transport.";

process Infiltration
    "Entry of liquid water from the ground surface into the underlying ground.";


/**
 * ## Areal analysis extension
 *
 * These experimental observations use the existing Areal Region convention.
 * Delineation, ground support and reference conventions remain observational
 * requirements; no new surface realm or automatic containment is inferred.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0062",
    revision="region-areal-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/region-areal-20261023/REVIEW_RECORD.json"
)
thing SurfaceCatchment
    "A surface region delineated by drainage toward one specified outlet under a stated convention."
    is earth:Region;


/**
 * ## Areal analysis extension
 *
 * These experimental observations use the existing Areal Region convention.
 * Delineation, ground support and reference conventions remain observational
 * requirements; no new surface realm or automatic containment is inferred.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0063",
    revision="region-areal-r1",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/region-areal-20261023/REVIEW_RECORD.json"
)
area CatchmentArea
    "Horizontal area of the delineated surface catchment."
    is imod:Area of hydrology:SurfaceCatchment
    describes hydrology:SurfaceCatchment;


/**
 * ## Material water across environmental settings
 *
 * Water material and its geographic region or host are distinct observations.
 * Natural water can contain dissolved or suspended constituents; this vocabulary
 * does not assert pure-H2O identity, constituent rules or partitive inherency.
 * Groundwater uses the saturated-zone meaning. Unsaturated soil/vadose water
 * remains within the broader subsurface meaning without becoming groundwater.
 * No universal moving parcel boundary, disjoint partition, marine/surface
 * hierarchy or new realm is asserted. Boundary and occurrence evidence remain
 * observational requirements. The linked record states placement review status.
 */

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0067",
    revision="water-earth-r2",
    maturity="experimental",
    controversy="unassessed",
    technical_validation="not_recorded",
    community_acceptance="not_recorded",
    review_record="../docs/reviews/water-earth-20261023/REVIEW_RECORD.json"
)
functional directed relationship TransfersWaterTo
    "Observed water transfer from an identified donor material water body to an identified recipient material water body."
    links earth:Water to earth:Water;

