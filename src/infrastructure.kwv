functional directed relationship SuppliesWaterTo
    "Actual delivery of water from an identified storage tank to an identified recipient tank."
    links infrastructure:WaterStorageTank to infrastructure:WaterStorageTank;

@review(
    schema="klab.review/1",
    proposal="wv-review-20261023-0074",
    revision="strawman-integration-r1",
    maturity="experimental",
